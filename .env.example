# Configuración de API GLPI
# URL base de tu servidor GLPI (ejemplo: https://tu-glpi.com o http://localhost/glpi)
VITE_GLPI_URL=https://tu-servidor-glpi.com/glpi/

# App-Token generado en GLPI (Configuración -> API -> Cliente API)
VITE_GLPI_APP_TOKEN=tu_app_token

# Habilitar modo Demo/Simulante si no hay conexión activa con un servidor GLPI real (true/false)
VITE_ENABLE_MOCK=false

# ── Avisos con la app cerrada (OPCIONAL, servicio "push"; ver README) ──
# Token de API de un usuario de GLPI de solo lectura (Proyectos, Tareas de proyecto, Usuarios y
# Grupos). Vacío = push desactivado; la app funciona igual.
PUSH_GLPI_USER_TOKEN=
# Zona horaria de tu GLPI
# PUSH_TZ=America/Mexico_City
